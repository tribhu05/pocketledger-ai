# PocketLedger AI — Environment Configuration Example
# Copy to .env for custom configuration

ENVIRONMENT=local
DEBUG=false

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=60.0

# Storage & Upload Boundaries
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB

# Optional Tesseract OCR Custom Executable Path
# (Leave blank for auto-detection across standard system paths)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=/usr/bin/tesseract
